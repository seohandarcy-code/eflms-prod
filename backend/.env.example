APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./eflms.db
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=none

# uvicorn이 바인드할 포트. scripts/start-dev.ps1·stop-dev.ps1이 이 값을 읽어 backend를
# 기동/종료하고, frontend/vite.config.ts의 dev proxy 타겟도 이 값을 그대로 참조한다.
BACKEND_PORT=8000

# DATABASE_URL이 비어있을 때만 아래 값으로 PostgreSQL DSN을 자동 조립한다
# (둘 다 없으면 SQLite로 폴백). PDEP처럼 host/port/name은 ConfigMap, user/password는
# Secret으로 나눠 주입하는 배포 환경을 대비한 옵션 — 로컬 개발은 위 DATABASE_URL만 쓰면 됨.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=eflms
# DB_USER=
# DB_PASSWORD=

# true면 기동 시 설비 테이블이 비어있을 때 mock 데이터 30건을 자동 시딩한다(로컬 개발
# 편의용). 기본값 false — 운영/공유 환경 동작에 영향 없음. 마이그레이션(`alembic upgrade
# head`)은 여전히 미리 실행돼 있어야 함(스키마 자체를 만들어주지는 않음).
# AUTO_SEED_IF_EMPTY=true

# AUTH_MODE=local일 때만 관리자 로그인(사이드바 "관리자" 버튼 → DB 테이블 조회 화면)이
# 활성화된다. 비밀번호는 서버 재기동 시 항상 이 값(비어있으면 기본값 "0000")으로 리셋되며
# 파일에 영속화되지 않는다 — 여러 서버에 배포할 때 같은 기본 비밀번호를 공유하지 않도록
# 서버별로 다르게 주입한다.
# ADMIN_BOOTSTRAP_PASSWORD=
