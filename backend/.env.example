APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./eflms.db
CORS_ORIGINS=http://localhost:5173
AUTH_MODE=none

# uvicorn이 바인드할 포트. scripts/start-dev.ps1·stop-dev.ps1이 이 값을 읽어 backend를
# 기동/종료하고, frontend/vite.config.ts의 dev proxy 타겟도 이 값을 그대로 참조한다.
BACKEND_PORT=8000

# DATABASE_URL이 비어있을 때만 아래 값으로 PostgreSQL DSN을 자동 조립한다
# (둘 다 없으면 SQLite로 폴백). PDEP처럼 host/port/name은 ConfigMap, user/password는
# Secret으로 나눠 주입하는 배포 환경을 대비한 옵션 — 로컬 개발은 위 DATABASE_URL만 쓰면 됨.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=eflms
# DB_USER=
# DB_PASSWORD=

# true면 기동 시 설비 테이블이 비어있을 때 mock 데이터 30건을 자동 시딩한다(로컬 개발
# 편의용). 기본값 false — 운영/공유 환경 동작에 영향 없음. 마이그레이션(`alembic upgrade
# head`)은 여전히 미리 실행돼 있어야 함(스키마 자체를 만들어주지는 않음).
# AUTO_SEED_IF_EMPTY=true

# AUTH_MODE=local일 때만 관리자 로그인(사이드바 "관리자" 버튼 → DB 테이블 조회 화면)이
# 활성화된다. 비밀번호는 서버 재기동 시 항상 이 값(비어있으면 기본값 "0000")으로 리셋되며
# 파일에 영속화되지 않는다 — 여러 서버에 배포할 때 같은 기본 비밀번호를 공유하지 않도록
# 서버별로 다르게 주입한다.
# ADMIN_BOOTSTRAP_PASSWORD=

# AUTH_MODE=sso일 때 /admin 로그인 수단을 OIDC로 전환한다(로컬 Keycloak으로 검증 완료).
# SSO_ISSUER_URL이 비어있으면 SSO 자체가 비활성화된 것으로 간주해 /admin#error=...로 돌려보낸다.
# SSO_CLIENT_ID/SECRET은 issuer URL만 발급하는 사내 브로커라면 비워둘 수 있다.
# SSO_ISSUER_URL=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=
# 로그인 성공 시 allowed_users.sso_id와 대조할 OIDC 클레임 이름 — 표준 클레임이 아니라
# IdP마다 다르므로 실제 연동 전 사번/이메일 등 안정적 식별자로 확인 필요.
# SSO_USER_ID_CLAIM=email
# 콤마 구분 — 매칭되는 계정은 로그인마다 admin 권한이 자동 복구됨(락아웃 방지 안전망).
# 최초 배포 시 반드시 한 명 이상 채워야 함.
# SSO_ADMIN_ALLOWLIST=
# true면 AUTH_MODE=sso에서도 기존 비밀번호 로그인을 함께 열어둔다(브로커 client_id
# 발급 전 개발용). 공유 서버에서 켤 거면 ADMIN_BOOTSTRAP_PASSWORD를 기본값에서 반드시 변경.
# SSO_ALLOW_LOCAL_LOGIN=true
# OAuth state/nonce 세션 쿠키 서명 키. 로컬 dev는 비워두면 기동마다 임의 생성해도 무방.
# SESSION_SECRET_KEY=
# 실제 HTTPS 배포에서만 true (세션 쿠키에 Secure 플래그).
# SESSION_COOKIE_SECURE=false
# 프론트/백엔드 origin이 분리되는 배포에서만 필요(SSO 콜백 리다이렉트 대상).
# FRONTEND_BASE_URL=
# 사내 CA가 발급한 인증서를 쓰는 SSO 브로커(ADFS 등)에 연결할 때만 필요 — Python이
# Windows와 달리 사내 CA를 기본 신뢰하지 않아 SSL 검증에 실패하는 걸 막는다. 상대경로면
# backend/ 기준으로 해석(예: certs/internal-ca.pem). PEM 형식이 아니면 기동 시 경고.
# SSO_CA_BUNDLE_PATH=
